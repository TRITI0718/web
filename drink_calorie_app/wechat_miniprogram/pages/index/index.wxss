.page-shell {
  padding: 28rpx 24rpx 80rpx;
}

.glass,
.glass-soft {
  border: 1rpx solid rgba(255, 255, 255, .82);
  background: linear-gradient(135deg, rgba(255, 255, 255, .68), rgba(255, 253, 236, .46));
  box-shadow: 0 18rpx 50rpx rgba(91, 87, 46, .10), inset 0 1rpx 0 rgba(255, 255, 255, .96);
}

.glass-soft {
  box-shadow: 0 8rpx 24rpx rgba(91, 87, 46, .07), inset 0 1rpx 0 rgba(255, 255, 255, .9);
}

.hero {
  display: flex;
  align-items: center;
  min-height: 188rpx;
  padding: 30rpx;
  border-radius: 40rpx;
  background:
    radial-gradient(circle at 88% 22%, rgba(183, 202, 104, .48), transparent 28%),
    linear-gradient(135deg, rgba(255, 238, 166, .78), rgba(244, 241, 207, .86));
}

.hero-mark {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  margin-right: 24rpx;
  border-radius: 32rpx;
  background: linear-gradient(145deg, #f4dc79, #cbdc82);
}

.cup-body {
  position: absolute;
  left: 28rpx;
  bottom: 22rpx;
  width: 48rpx;
  height: 50rpx;
  border: 5rpx solid #52652f;
  border-radius: 5rpx 5rpx 14rpx 14rpx;
  background: linear-gradient(180deg, #fffdf1 0 40%, #779242 40% 100%);
}

.cup-leaf {
  position: absolute;
  left: 53rpx;
  top: 17rpx;
  width: 25rpx;
  height: 14rpx;
  border-radius: 100% 0 100% 0;
  background: #7e9b45;
  transform: rotate(-28deg);
}

.hero-copy {
  display: flex;
  flex-direction: column;
}

.hero-title {
  font-size: 43rpx;
  line-height: 1.1;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.hero-caption {
  margin-top: 14rpx;
  color: rgba(74, 78, 55, .68);
  font-size: 24rpx;
  letter-spacing: 3rpx;
}

.search-wrap {
  margin-top: 24rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
}

.search-input {
  height: 92rpx;
  color: #303624;
  font-size: 30rpx;
}

.brand-scroll,
.range-scroll {
  width: 100%;
  margin-top: 22rpx;
  white-space: nowrap;
}

.chip-row {
  display: inline-flex;
  gap: 14rpx;
  padding: 2rpx 2rpx 10rpx;
}

.filter-chip {
  flex: 0 0 auto;
  padding: 18rpx 26rpx;
  border: 1rpx solid rgba(180, 173, 103, .36);
  border-radius: 999rpx;
  color: #67694f;
  background: rgba(255, 255, 255, .42);
  font-size: 25rpx;
}

.filter-chip.active {
  color: #42541e;
  border-color: rgba(99, 123, 45, .62);
  background: rgba(210, 222, 139, .56);
}

.picker-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.picker-card {
  display: flex;
  min-height: 108rpx;
  padding: 18rpx;
  box-sizing: border-box;
  flex-direction: column;
  justify-content: center;
  border-radius: 24rpx;
}

.picker-label,
.stat-label {
  color: rgba(74, 78, 55, .58);
  font-size: 21rpx;
}

.picker-value {
  margin-top: 8rpx;
  overflow: hidden;
  color: #3b402d;
  font-size: 24rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.range-title {
  margin-top: 30rpx;
  font-size: 31rpx;
  font-weight: 750;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin: 28rpx 0;
}

.stat-card {
  display: flex;
  min-height: 132rpx;
  padding: 20rpx;
  box-sizing: border-box;
  flex-direction: column;
  justify-content: center;
  border-radius: 28rpx;
}

.stat-value {
  margin-top: 10rpx;
  color: #62654d;
  font-size: 31rpx;
  font-weight: 780;
}

.drink-card {
  position: relative;
  min-height: 250rpx;
  margin-bottom: 22rpx;
  overflow: hidden;
  border-radius: 34rpx;
  transition: transform .16s ease, opacity .16s ease;
}

.drink-card-pressed {
  transform: scale(.992);
  opacity: .9;
}

.card-gradient {
  position: absolute;
  z-index: 0;
  left: 0;
  right: 0;
  bottom: 0;
  height: 91%;
}

.card-content {
  position: relative;
  z-index: 1;
  padding: 30rpx;
}

.drink-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.drink-main {
  display: flex;
  align-items: flex-start;
  min-width: 0;
  gap: 18rpx;
}

.rank {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(183, 173, 101, .45);
  border-radius: 22rpx;
  color: #73764e;
  background: rgba(242, 238, 207, .72);
  font-size: 24rpx;
  font-weight: 750;
}

.drink-name {
  overflow: hidden;
  color: #303624;
  font-size: 31rpx;
  font-weight: 760;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.drink-meta {
  margin-top: 8rpx;
  color: #858b94;
  font-size: 22rpx;
}

.metric {
  flex: 0 0 auto;
  font-size: 36rpx;
  font-weight: 820;
  white-space: nowrap;
}

.nutrition-row {
  display: flex;
  margin-top: 20rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx;
}

.nutrition-row text {
  padding: 11rpx 15rpx;
  border: 1rpx solid rgba(74, 78, 55, .12);
  border-radius: 14rpx;
  color: rgba(74, 78, 55, .68);
  background: rgba(74, 78, 55, .055);
  font-size: 21rpx;
}

.source-line {
  margin-top: 38rpx;
  color: #808793;
  font-size: 21rpx;
}

.load-more {
  margin: 30rpx 0;
  border-radius: 999rpx;
  color: #4d5d27;
  background: rgba(215, 225, 153, .72);
  font-size: 27rpx;
}

.empty,
.footer-note {
  padding: 42rpx 0;
  color: rgba(74, 78, 55, .58);
  text-align: center;
  font-size: 24rpx;
}

@media (max-width: 370px) {
  .picker-grid,
  .stats-grid {
    grid-template-columns: 1fr;
  }

  .drink-top {
    flex-direction: column;
  }
}
